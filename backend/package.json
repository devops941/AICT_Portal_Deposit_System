{
  "name": "security-deposit-backend",
  "version": "1.0.0",
  "description": "AICTE Security Deposit & FDR Lifecycle Management Portal Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "seed:institutions": "tsx src/scripts/seed_10_institutions_and_requirements.ts",
    "seed:fdrs": "tsx src/scripts/seed_fdrs_verifications_approvals.ts",
    "seed:lifecycle": "tsx src/scripts/seed_renewals_and_releases.ts",
    "seed:users": "tsx src/scripts/seed_portal_users.ts"
  },
  "keywords": [
    "aicte",
    "fdr",
    "security-deposit",
    "express",
    "mongoose",
    "typescript"
  ],
  "author": "AICTE Architecture Team",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bignumber.js": "^11.1.5",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.12.1",
    "morgan": "^1.10.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
