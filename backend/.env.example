# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/aicte_security_deposit

# Authentication Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_key_change_in_production_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production_min_32_chars

# Client URL (CORS)
CLIENT_URL=http://localhost:5173

# Document Storage Configuration (e.g., s3, local, minio)
DOCUMENT_STORAGE_PROVIDER=local
DOCUMENT_STORAGE_BUCKET=fdr-documents-bucket

# Email Notification Configuration (SMTP)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=587
EMAIL_USER=your_smtp_username
EMAIL_PASSWORD=your_smtp_password

# Redis Configuration (Optional / Phase 2 caching & jobs)
REDIS_URL=redis://127.0.0.1:6379
